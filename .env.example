# Public browser configuration. These values are intentionally exposed by Vite.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Server configuration.
# SUPABASE_URL and SUPABASE_ANON_KEY are optional server-side aliases.
# If omitted, the VAULTX server falls back to the VITE_ values above.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# REQUIRED SERVER-ONLY SECRET.
# Generate locally with: openssl rand -hex 32
# Never prefix this with VITE_ and never commit the actual value.
VAULTX_ENCRYPTION_KEY=

# Optional AI Studio configuration.
GEMINI_API_KEY=
APP_URL=
